{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "national_id.v1",
  "title": "National ID card (national_id.v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detected_document_type",
    "readable",
    "unreadable_reason",
    "page_count_seen",
    "fields",
    "warnings"
  ],
  "properties": {
    "detected_document_type": {
      "type": "string",
      "enum": [
        "national_id",
        "passport",
        "kra_pin",
        "cr12",
        "certificate_of_incorporation",
        "bank_statement",
        "mpesa_statement",
        "audited_financial_statements",
        "title_deed",
        "logbook",
        "valuation_report",
        "crb_report",
        "other"
      ],
      "description": "What this document actually is, whatever it was declared as."
    },
    "readable": {
      "type": "boolean",
      "description": "False if the page or document can't be read reliably."
    },
    "unreadable_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Why it can't be read (blur, glare, cropped, too dark ...), or null."
    },
    "page_count_seen": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id_number",
        "full_name",
        "date_of_birth",
        "sex",
        "place_of_birth",
        "date_of_issue",
        "serial_number",
        "district"
      ],
      "properties": {
        "id_number": {
          "$ref": "#/$defs/field",
          "description": "ID number, digits only. Digits only."
        },
        "full_name": {
          "$ref": "#/$defs/field",
          "description": "Full name exactly as printed."
        },
        "date_of_birth": {
          "$ref": "#/$defs/field",
          "description": "Date as YYYY-MM-DD."
        },
        "sex": {
          "$ref": "#/$defs/field",
          "description": "M or F. M or F."
        },
        "place_of_birth": {
          "$ref": "#/$defs/field",
          "description": "As printed."
        },
        "date_of_issue": {
          "$ref": "#/$defs/field",
          "description": "Date as YYYY-MM-DD."
        },
        "serial_number": {
          "$ref": "#/$defs/field",
          "description": "Serial number of the card."
        },
        "district": {
          "$ref": "#/$defs/field",
          "description": "District of birth or issue, as printed."
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence",
        "source_page",
        "source_text",
        "legibility",
        "notes"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exactly what is printed (normalised as described), or null if it is absent or can't be read."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 to 1: how sure you are the value is read correctly."
        },
        "source_page": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based page the value is on."
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "maxLength": 120,
          "description": "Up to 80 characters copied from around the value."
        },
        "legibility": {
          "type": "string",
          "enum": [
            "good",
            "partial",
            "unreadable"
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Anything the reviewer should know, or null."
        }
      }
    }
  }
}
