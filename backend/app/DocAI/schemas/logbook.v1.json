{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logbook.v1",
  "title": "Logbook (vehicle registration certificate) (logbook.v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detected_document_type",
    "readable",
    "unreadable_reason",
    "page_count_seen",
    "fields",
    "warnings"
  ],
  "properties": {
    "detected_document_type": {
      "type": "string",
      "enum": [
        "national_id",
        "passport",
        "kra_pin",
        "cr12",
        "certificate_of_incorporation",
        "bank_statement",
        "mpesa_statement",
        "audited_financial_statements",
        "title_deed",
        "logbook",
        "valuation_report",
        "crb_report",
        "other"
      ],
      "description": "What this document actually is, whatever it was declared as."
    },
    "readable": {
      "type": "boolean",
      "description": "False if the page or document can't be read reliably."
    },
    "unreadable_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Why it can't be read (blur, glare, cropped, too dark ...), or null."
    },
    "page_count_seen": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_number",
        "make",
        "model",
        "year_of_manufacture",
        "chassis_number",
        "engine_number",
        "registered_owners",
        "financier_interest",
        "colour"
      ],
      "properties": {
        "registration_number": {
          "$ref": "#/$defs/field",
          "description": "As printed."
        },
        "make": {
          "$ref": "#/$defs/field",
          "description": "As printed."
        },
        "model": {
          "$ref": "#/$defs/field",
          "description": "As printed."
        },
        "year_of_manufacture": {
          "$ref": "#/$defs/field",
          "description": "Four-digit year."
        },
        "chassis_number": {
          "$ref": "#/$defs/field",
          "description": "As printed."
        },
        "engine_number": {
          "$ref": "#/$defs/field",
          "description": "As printed."
        },
        "registered_owners": {
          "$ref": "#/$defs/field",
          "description": "All registered owners, separated by semicolons."
        },
        "financier_interest": {
          "$ref": "#/$defs/field",
          "description": "Any financier or co-owner interest shown."
        },
        "colour": {
          "$ref": "#/$defs/field",
          "description": "As printed."
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence",
        "source_page",
        "source_text",
        "legibility",
        "notes"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exactly what is printed (normalised as described), or null if it is absent or can't be read."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 to 1: how sure you are the value is read correctly."
        },
        "source_page": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based page the value is on."
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "maxLength": 120,
          "description": "Up to 80 characters copied from around the value."
        },
        "legibility": {
          "type": "string",
          "enum": [
            "good",
            "partial",
            "unreadable"
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Anything the reviewer should know, or null."
        }
      }
    }
  }
}
