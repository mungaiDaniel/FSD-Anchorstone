# Copy to .env and fill in. .env is git-ignored — never commit real values.

# development | production | testing
APP_ENV=development

# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and makes a saved SMTP password unreadable.
SECRET_KEY=

DATABASE_URI=postgresql://USER:PASSWORD@localhost/statement
# Wiped by the test suite on every run — never point at real data.
TEST_DATABASE_URI=postgresql://USER:PASSWORD@localhost/statement_test

CORS_ORIGINS=http://localhost:5173

# Email (can also be set later in Settings -> Email Sending by a super admin)
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_BCC=
# true = nothing is actually sent (default in development)
MAIL_SUPPRESS_SEND=true
# Emails are sent by the worker process: flask --app main worker
EMAIL_QUEUE_INTERVAL_MINUTES=2
EMAIL_QUEUE_BATCH_SIZE=100

# Shown in email and statement footers
COMPANY_ADDRESS=
COMPANY_CONTACT=

# Sign-in protection (defaults shown)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_FAILURES=20
# Number of reverse proxies in front of the app (0 = none). Required behind nginx/a load balancer.
TRUSTED_PROXY_COUNT=0

# Daily pg_dump -> OneDrive backups (off until configured)
DB_BACKUP_ENABLED=false

# Encrypted document storage. Generate the key once and keep it safe (see config.py).
DOCUMENT_KEK=
DOCUMENT_KEK_ID=env-1
PG_DUMP_PATH=pg_dump
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ONEDRIVE_USER_ID=
